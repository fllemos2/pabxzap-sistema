# Copie para .env (que NÃO vai para o git) e preencha. Nunca cole estas chaves no chat.

# Supabase (Project Settings › API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta (App Dashboard do app PabxZap)
META_APP_ID=
META_APP_SECRET=
# Token que a Meta envia na verificação do webhook (você inventa; o mesmo valor vai no App Dashboard)
META_WEBHOOK_VERIFY_TOKEN=
# Token permanente de um usuário do sistema (Business Settings › System users), com whatsapp_business_messaging e whatsapp_business_management.
# O webhook usa este para responder; sem ele, usa META_TEST_ACCESS_TOKEN, que vence em 24 h.
META_ACCESS_TOKEN=
# Número de teste (API Setup) — só para a fase de construção
META_TEST_PHONE_NUMBER_ID=
META_TEST_ACCESS_TOKEN=
# ID da conta do WhatsApp ("Messaging account ID" em Step 1. Try it out); usado quando o token não informa a conta
META_WABA_ID=
# Telefone do destinatário de teste dos vídeos do App Review (só dígitos, com o 55 e o DDD; ex.: 5511987654321)
META_TEST_RECIPIENT=

# Conexão direta com o banco (Supabase › Connect › Session pooler › URI), com a senha do banco no lugar de [YOUR-PASSWORD]
SUPABASE_DB_URL=

# Token pessoal do Supabase (supabase.com › Account › Access Tokens), usado só para publicar a função (npm run webhook:publicar)
SUPABASE_ACCESS_TOKEN=

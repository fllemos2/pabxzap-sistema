# Copie para .env (que NÃO vai para o git) e preencha. Nunca cole estas chaves no chat.

# Supabase (Project Settings › API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta (App Dashboard do app PabxZap)
META_APP_ID=
META_APP_SECRET=
# Token que a Meta envia na verificação do webhook (você inventa; o mesmo valor vai no App Dashboard)
META_WEBHOOK_VERIFY_TOKEN=
# Número de teste (API Setup) — só para a fase de construção
META_TEST_PHONE_NUMBER_ID=
META_TEST_ACCESS_TOKEN=
